%% @機型: Kebbi Air S
%% @語氣: 朝氣
%% @語別: 西群卑南語
%% @變數: {{lang}} 語言完成、{{cult}} 文化完成、{{name}} 參觀者姓名
%% @素材: 紅花＝語言、黃花＝文化、白花＝挑戰（置於花環正中）
flowchart LR

classDef trg  fill:#FFF3CD,stroke:#B0740B,color:#111
classDef brc  fill:#D6EEF1,stroke:#0D6F79,color:#111
classDef core fill:#D7EDE0,stroke:#2A7350,color:#111
classDef aux  fill:#E4E7EB,stroke:#5F6B7C,color:#111
classDef adv  fill:#F8DED9,stroke:#A83A2B,color:#111
classDef end0 fill:#FFFFFF,stroke:#999,color:#666

subgraph S1["S1｜常設展演時段"]
  direction LR
  %% ── F1 卑南族文化體驗 ──
  S1F1_00(["S1F1_00<br/>觸發｜看到參觀者"]):::trg
  %% @觸發方式: 看到人
  %% @觸發細節: 中距離人臉／所有人
  %% @變數: {{lang}} = 0、{{cult}} = 0
  S1F1_01["S1F1_01<br/>機器人表現｜文化大使自我介紹"]:::core
  %% @機器人表現（依序）: 語音：你好，我是文化大使凱比 / 表情：微笑 / 動作：招手
  %% @隨機一個: 否
  %% @自動結束秒數: 不自動結束
  %% @發音語言: 繁體中文
  %% @結尾語: 摸摸我的頭就可以開始。
  S1F1_02{"S1F1_02<br/>觸碰分流｜等待摸頭"}:::brc
  %% @開場語: 摸摸我的頭，我們就出發囉！
  %% @觸碰部位: 頭
  %% @循環提示秒數／提示語: 15 秒／再說一次提示語
  %% @自動結束秒數: 60 秒
  %% @關鍵字[摸頭]: 頭
  S1F1_03["S1F1_03<br/>資料填寫｜輸入姓名"]:::core
  %% @開場語: 先告訴我你的名字，好嗎？
  %% @填寫格式: 文字
  %% @必填: 否（顯示跳過按鈕）
  %% @標題文字（≤120 字）: 請輸入你的名字
  %% @讓機器人唸出標題: 是
  %% @顯示時長: 60 秒
  %% @賦值變數: {{name}}
  %% @結尾語: {{name}}，我記住你了！
  S1F1_04["S1F1_04<br/>媒體與工具｜先教一句 inavayan"]:::core
  %% @開場語: 先教你一句卑南語。跟我唸：inavayan。
  %% @資源類型: 內容編輯器
  %% @資源名稱／連結: bn01_inavayan.mp3
  %% @播放時長: 播完自動結束
  %% @播放中表現: 表情：微笑
  %% @結尾語: 很棒！
  S1F1_05["S1F1_05<br/>機器人表現｜任務說明"]:::core
  %% @機器人表現（依序）: 語音：完成一個活動，就可以得到一朵花 / 語音：集滿三朵，花環就完成了 / 圖片：garland_empty.png
  %% @隨機一個: 否
  %% @自動結束秒數: 不自動結束
  %% @發音語言: 繁體中文
  %% @結尾語: 準備好了嗎？我們開始吧！
  S1F1_L0{"S1F1_L0<br/>選單｜主選單"}:::brc
  %% @開場語: {{name}}，你想先做哪一個？
  %% @版面設定: 題目 1／選項 3，一頁三個
  %% @依序唸出選項: 是
  %% @機器人發音語言: 繁體中文
  %% @返回／離開按鈕: 關閉返回、開啟離開
  %% @語音辨識模式: 允許語音選擇
  %% @ChatGPT 閥值: 70%
  %% @選單顯示時長: 不自動關閉
  %% @變數: {{choice}}
  %% @關鍵字[語言介紹]: 語言,說話,卑南語
  %% @關鍵字[文化介紹]: 文化,阿拜,avay,吃的
  %% @關鍵字[關卡挑戰]: 挑戰,考試,關卡,題目
  S1F1_1["S1F1_1<br/>媒體與工具｜語言卡①　inavayan"]:::core
  %% @開場語: 跟我唸：inavayan
  %% @資源類型: 內容編輯器
  %% @資源名稱／連結: bn01_inavayan.mp3　／　card_01.png
  %% @播放時長: 播完後等使用者點下一張
  %% @播放中表現: 表情：微笑
  %% @結尾語: 再一次：inavayan
  S1F1_1b["S1F1_1b<br/>媒體與工具｜語言卡②　inavayan i ___ kum ngadan"]:::core
  %% @開場語: 跟我唸：inavayan i ___ kum ngadan
  %% @資源類型: 內容編輯器
  %% @資源名稱／連結: bn02.mp3　／　card_02.png
  %% @播放時長: 播完後等使用者點下一張
  %% @播放中表現: 表情：微笑
  %% @結尾語: 再一次：inavayan i ___ kum ngadan
  S1F1_1c["S1F1_1c<br/>媒體與工具｜語言卡③　semangal ku kirekalrazam kannu"]:::core
  %% @開場語: 跟我唸：semangal ku kirekalrazam kannu
  %% @資源類型: 內容編輯器
  %% @資源名稱／連結: bn03.mp3　／　card_03.png
  %% @播放時長: 播完後等使用者點下一張
